    <string name="onboarding_page_welcome_title">欢迎使用 Seal</string>
    <string name="onboarding_page_welcome_body">这是 Seal 的 Chloemlla 分支。接下来会说明它相对上游的主要改进，以及如何快速上手。</string>
    <string name="onboarding_page_identity_title">独立应用身份</string>
    <string name="onboarding_page_identity_body">应用包名为 com.chloemlla.seal（含 debug / preview 变体）。它不是上游 F-Droid 包，发布与更新链接指向 Chloemlla/Seal。</string>
    <string name="onboarding_page_platform_title">现代 Android 平台适配</string>
    <string name="onboarding_page_platform_body">面向当前 Android 版本构建（compile / target SDK 37），并更新了工具链、依赖栈与通知/进度表现。</string>
    <string name="onboarding_page_storage_title">更安全的存储默认策略</string>
    <string name="onboarding_page_storage_body">常规下载使用分区存储，不再依赖 MANAGE_EXTERNAL_STORAGE。偏好设置采用更快的多存储布局，历史文件清理也更可靠。</string>
    <string name="onboarding_page_delegate_title">第三方委托下载</string>
    <string name="onboarding_page_delegate_body">其他应用可通过分享、打开链接或 DOWNLOAD Intent 把任务交给 Seal。下载始终由 Seal 执行，并在设置允许时回传状态。</string>
    <string name="onboarding_page_ytdlp_title">稳定版 yt-dlp 打包</string>
    <string name="onboarding_page_ytdlp_body">应用在构建时内置最新 Stable yt-dlp，并将应用内更新通道默认设为 Stable，下载体验更可预期。</string>
    <string name="onboarding_page_security_title">安全与隐私加固</string>
    <string name="onboarding_page_security_body">外部入口校验更严格。第三方调用受你控制：总开关、可选自动开始，以及包名白名单。</string>
    <string name="onboarding_page_usage_title">快速上手提示</string>
    <string name="onboarding_page_usage_body">开始第一次下载前，先了解这些要点：</string>
    <string name="known_issue_app_stop_title">为什么应用会突然失效？</string>
    <string name="known_issue_app_stop_solution">通常是因为站点反爬更新、yt-dlp 过旧，或 IP 被限制。请先在故障排除页更新 yt-dlp 再重试。Instagram / Facebook / Twitter / YouTube 建议生成并启用 Cookies。</string>
    <string name="known_issue_social_fail_title">Instagram、Facebook、Twitter 下载失败</string>
    <string name="known_issue_social_fail_solution">请到 设置 → 网络 → Cookies 中为这些站点生成并启用 Cookies，然后在开启 Cookies 的情况下重试下载。</string>
    <string name="known_issue_youtube_bot_title">[youtube] 需要登录确认你不是机器人 / HTTP 403 Forbidden</string>
    <string name="known_issue_youtube_bot_solution">当前 IP 很可能被 YouTube 限制。请更换网络/IP（或使用 VPN），更新 yt-dlp，并在需要时启用 Cookies。</string>
    <string name="known_issue_tiktok_post_title">TikTok 后处理：打开输入文件错误 / Invalid data found when processing input</string>
    <string name="known_issue_tiktok_post_solution">这通常与 IP / CDN 有关。请更换 IP 后重试，或等待上游 yt-dlp / 站点侧修复。</string>
    <string name="known_issue_python_title">Python 错误 / 不支持的 Python 版本</string>
    <string name="known_issue_python_solution">请将 Seal 更新到最新版本（v1.13.1 或更新），并更新 yt-dlp。</string>
    <string name="known_issue_libandroid_title">无法链接可执行文件：找不到库 \"libandroid-support.so\"</string>
    <string name="known_issue_libandroid_solution">请重新安装应用，或清除应用数据后重试。</string>
    <string name="known_issue_ffmpeg_oxygen_title">OxygenOS 15 beta 上出现 --ffmpeg-location 错误</string>
    <string name="known_issue_ffmpeg_oxygen_solution">在部分 OnePlus / OPPO 的 Android 15 系统上，后台原生进程会被系统杀掉。请等待厂商系统更新。</string>
